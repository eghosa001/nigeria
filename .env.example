# MyNigeriaGuide public pages work with no database.

# Optional persistent correction-report backend.
# Recommended later: a tiny Cloudflare Worker using D1.
MYNIGERIAGUIDE_REPORT_ENDPOINT=
MYNIGERIAGUIDE_REPORT_TOKEN=

# Production/search analytics
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Private Visits dashboard (server-side only; never expose these to the browser)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
MYNIGERIAGUIDE_ADMIN_ANALYTICS_KEY=

# Advertising stays disabled until these are intentionally configured.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
