# MyNigeriaGuide public pages work with no database.

# Optional persistent correction-report backend.
# Recommended later: a tiny Cloudflare Worker using D1.
MYNIGERIAGUIDE_REPORT_ENDPOINT=
MYNIGERIAGUIDE_REPORT_TOKEN=

# Production/search analytics
NEXT_PUBLIC_SITE_URL=https://mynigeriaguide.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# PostHog public browser identifiers. The code also has production fallbacks.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Private Visits dashboard (server-side only; never expose these to the browser)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional Search Console overrides. If email/key are blank, the dashboard reuses
# the GA4 service account and requests webmasters.readonly scope.
GSC_SITE_URL=sc-domain:mynigeriaguide.com
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=
MYNIGERIAGUIDE_ADMIN_ANALYTICS_KEY=
# Server-only PostHog personal key with Query: Read access.
# Never expose this value through NEXT_PUBLIC_*.
POSTHOG_PERSONAL_API_KEY=

# Google AdSense. Public identifiers, not secrets.
# Leave NEXT_PUBLIC_ADSENSE_CLIENT blank to keep all advertising disabled site-wide.
# Setting the client without slot IDs still keeps /ads.txt live and the loader enabled.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Named placements. See lib/adsense-config.ts. Each may be blank to disable that one ad.
NEXT_PUBLIC_ADSENSE_SLOT_SERVICE_AFTER_ANSWER=
NEXT_PUBLIC_ADSENSE_SLOT_SERVICE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_MOVIE_AFTER_CAST=
NEXT_PUBLIC_ADSENSE_SLOT_MOVIE_AFTER_WATCH=
NEXT_PUBLIC_ADSENSE_SLOT_JOB_AFTER_FACTS=
NEXT_PUBLIC_ADSENSE_SLOT_TOUR_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_END_MULTIPLEX=

# Server-only fine-grained GitHub token used by protected admin guide editing.
# Limit to eghosa001/nigeria with Contents: read/write and Pull requests: read/write.
MYNIGERIAGUIDE_GITHUB_ADMIN_TOKEN=
