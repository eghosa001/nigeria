{
  "name": "mynigeriaguide",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vinext build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:sources": "node scripts/check-sources.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "check:cloudflare": "vinext check",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "vinext-cloudflare deploy --skip-build --config dist/server/wrangler.json",
    "check:content": "tsx scripts/check-content-quality.ts",
    "build:next": "next build"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vinext": "1.0.0-beta.11",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "react-server-dom-webpack": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@axe-core/playwright": "^4.10.2",
    "vite": "8.3.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitejs/plugin-react": "6.1.1",
    "@cloudflare/vite-plugin": "1.54.11",
    "wrangler": "4.133.0",
    "tsx": "^4.20.6"
  },
  "type": "module"
}
