{
  "name": "mynigeriaguide",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vinext build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:sources": "node scripts/check-sources.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "check:cloudflare": "vinext check",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "check:content": "tsx scripts/check-content-quality.ts",
    "check:scale": "tsx scripts/check-scale-contract.ts",
    "scale:status": "tsx scripts/check-scale-contract.ts",
    "build:next": "next build",
    "prebuild": "node scripts/write-deployment-info.mjs",
    "prebuild:vinext": "node scripts/write-deployment-info.mjs",
    "prebuild:next": "node scripts/write-deployment-info.mjs",
    "check:service-catalog": "tsx scripts/verify-service-migration.ts",
    "check:analytics-safety": "tsx scripts/check-analytics-safety.ts",
    "sync:youtube-entertainment": "node scripts/sync-youtube-entertainment.mjs",
    "check:entertainment-scale": "node --check scripts/sync-youtube-entertainment.mjs && node scripts/check-entertainment-scale.mjs",
    "check:explore": "tsx scripts/check-explore-content.ts",
    "check:crawl-resilience": "node scripts/check-crawl-resilience.mjs",
    "postbuild": "node scripts/write-wrangler-deploy-config.mjs",
    "postbuild:vinext": "node scripts/write-wrangler-deploy-config.mjs",
    "check:jobs": "tsx scripts/check-jobs-content.ts",
    "check:job-links": "node scripts/check-job-links.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vinext": "1.0.0-beta.11",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "react-server-dom-webpack": "19.3.0",
    "posthog-js": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@axe-core/playwright": "^4.10.2",
    "vite": "8.3.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitejs/plugin-react": "6.1.1",
    "@cloudflare/vite-plugin": "1.54.11",
    "wrangler": "4.135.0",
    "tsx": "^4.20.6"
  },
  "type": "module"
}
