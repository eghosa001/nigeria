{
  "name": "mynigeriaguide",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vinext build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:sources": "node scripts/check-sources.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "check:cloudflare": "vinext check",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "check:content": "tsx scripts/check-content-quality.ts && tsx scripts/audit-editorial-voice.ts --summary && npm run check:humanizer && npm run check:performance-policy",
    "check:performance-policy": "tsx --test tests/public-hub-performance-policy-20261019.test.ts && node --test tests/cwv-critical-path-20261023.test.mjs tests/intent-navigation-performance-20261023.test.mjs",
    "check:humanizer": "tsx --test tests/sitewide-humanizer-coverage-20261018.test.ts tests/humanizer-sitewide-templates-20261018.test.ts",
    "audit:voice": "tsx scripts/audit-editorial-voice.ts",
    "audit:repetition": "tsx scripts/audit-reader-repetition.ts",
    "check:repetition": "tsx --test tests/sitewide-page-repetition-20261021.test.ts",
    "check:scale": "tsx scripts/check-scale-contract.ts",
    "scale:status": "tsx scripts/check-scale-contract.ts",
    "build:next": "next build",
    "prebuild": "node scripts/write-deployment-info.mjs && tsx scripts/generate-static-sitemaps.ts && node --test tests/sitemap-ads-assets.test.mjs",
    "prebuild:vinext": "node scripts/write-deployment-info.mjs && tsx scripts/generate-static-sitemaps.ts && node --test tests/sitemap-ads-assets.test.mjs",
    "prebuild:next": "node scripts/write-deployment-info.mjs && tsx scripts/generate-static-sitemaps.ts && node --test tests/sitemap-ads-assets.test.mjs",
    "check:service-catalog": "tsx scripts/verify-service-migration.ts",
    "check:analytics-safety": "tsx scripts/check-analytics-safety.ts && node --test tests/search-discovery-contract.test.mjs",
    "audit:codebase": "node scripts/audit-codebase.mjs",
    "sync:youtube-entertainment": "node scripts/sync-youtube-entertainment.mjs",
    "check:entertainment-scale": "node --check scripts/sync-youtube-entertainment.mjs && node scripts/check-entertainment-scale.mjs && tsx scripts/check-entertainment-content.ts && tsx --test tests/movie-featured-cast-consistency-20261018.test.ts tests/film-client-bundle-regression-20261019.test.ts",
    "check:explore": "tsx scripts/check-explore-content.ts",
    "check:crawl-resilience": "node scripts/check-crawl-resilience.mjs",
    "postbuild": "node scripts/write-wrangler-deploy-config.mjs",
    "postbuild:vinext": "node scripts/write-wrangler-deploy-config.mjs",
    "check:jobs": "tsx scripts/check-jobs-content.ts && tsx scripts/check-job-redirects.ts",
    "check:job-links": "node scripts/check-job-links.mjs",
    "check:entertainment-content": "tsx scripts/check-entertainment-content.ts && tsx scripts/check-premium-film-guides.ts",
    "check:freshness": "tsx scripts/check-freshness.ts",
    "quality:status": "tsx scripts/report-content-quality.ts",
    "check:directory-queries": "tsx scripts/check-directory-queries.ts",
    "audit:publisher": "tsx scripts/audit-publisher-readiness.ts",
    "audit:publication": "tsx scripts/audit-publication-standards.ts",
    "check:crawl-assets": "node --test tests/sitemap-ads-assets.test.mjs",
    "check:premium-film-guides": "tsx scripts/check-premium-film-guides.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vinext": "1.0.0-beta.11",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "react-server-dom-webpack": "19.3.0",
    "posthog-js": "1.413.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@axe-core/playwright": "^4.10.2",
    "vite": "8.3.4",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitejs/plugin-react": "6.1.1",
    "@cloudflare/vite-plugin": "1.54.11",
    "wrangler": "4.135.0",
    "tsx": "^4.20.6"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "vite": "8.3.4"
  }
}
